# Public Supabase browser configuration (use the values for your own project).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# disabled: existing provider; test: fictitious data only; production: local
# fiscal issuance for configured installations. Production requires the bridge,
# migrations, fiscal review, AEAT tests and an issued responsible declaration.
VITE_VERIFACTU_MODE=production

# Development-only supplier document fixtures. Production builds ignore this flag.
VITE_SUPPLIER_DOCUMENT_MOCK_MODE=false
