{
  "compilerOptions": {
    "target": "es2023", "module": "nodenext", "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true, "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "types": ["node"], "allowJs": true, "checkJs": false
  },
  "include": ["src"]
}
