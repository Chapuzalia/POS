{
  "name": "pos",
  "private": true,
  "version": "1.0.30",
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "scripts": {
    "dev:api": "pnpm --filter @tickit/api dev",
    "start:api": "pnpm --filter @tickit/api start",
    "build:api": "pnpm --filter @tickit/api build",
    "dev": "vite",
    "build": "pnpm run build:api && tsc -b && vite build",
    "test": "pnpm run test:functional && pnpm run test:legacy",
    "test:functional": "vitest run",
    "test:legacy": "node --test tests/*.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:android": "vite build && pnpm run build:print-agent && cap sync android",
    "apk:debug": "pnpm run build:android && cd android && gradlew.bat assembleDebug",
    "ios:device": "bash scripts/ios-device.sh",
    "build:print-agent": "node ../backend-impresora/scripts/build-mobile.mjs dist/nodejs",
    "build:ios": "vite build && pnpm run build:print-agent && cap sync ios",
    "build:android:prod": "vite build --mode prod && pnpm run build:print-agent && cap sync android",
    "build:ios:prod": "vite build --mode prod && pnpm run build:print-agent && cap sync ios",
    "ios:archive": "bash scripts/ios-archive.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capawesome/capacitor-nodejs": "^0.2.0",
    "@heroui/react": "3.2.2",
    "@heroui/styles": "3.2.2",
    "@internationalized/date": "3.12.2",
    "@jsquash/webp": "1.5.0",
    "@sentry/react": "^10.68.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "@types/qrcode": "^1.5.6",
    "driver.js": "1.10.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sileo": "^0.1.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@electric-sql/pglite": "^0.5.8",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "fake-indexeddb": "6.2.4",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.5"
  }
}
