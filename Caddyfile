{
	admin off
	persist_config off
	auto_https off

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	root * /app/dist
	encode gzip zstd
	log {
		format json
	}
	header {
		X-Content-Type-Options nosniff
		Cache-Control "no-store"
	}
	header -Server
	@manifest path /manifest.webmanifest /crm.webmanifest
	header @manifest Content-Type "application/manifest+json; charset=utf-8"
	header /sw.js Service-Worker-Allowed /

	route {
		respond /health 200

		@crmQuery {
			path /crm
			expression `{query} != ""`
		}
		redir @crmQuery /crm/?{query} 308
		redir /crm /crm/ 308

		# Missing chunks must be 404, never a cacheable HTML fallback under a JS URL.
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server {
				hide .git .env*
			}
		}

		@file path_regexp file \.[^/]+$
		handle @file {
			file_server {
				hide .git .env*
			}
		}

		handle /crm/* {
			rewrite * /crm/index.html
			file_server {
				hide .git .env*
			}
		}

		handle {
			try_files {path} /index.html
			file_server {
				hide .git .env*
			}
		}
	}

	handle_errors {
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
